---
import Icon from '../atoms/Icon.astro';

interface Props {
  title: string;
  description: string;
  icon:
    | 'layers'
    | 'lock'
    | 'footprints'
    | 'send'
    | 'brain'
    | 'activity'
    | 'shield'
    | 'terminal'
    | 'zap';
  colSpan?: 4 | 6 | 8 | 12;
  class?: string;
  badgeText?: string;
}

const {
  title,
  description,
  icon,
  colSpan = 4,
  badgeText,
  class: className = ''
} = Astro.props;
---

<div class={`bento-card col-span-${colSpan} ${className}`}>
  <div class="bento-header">
    <div class="bento-icon-box">
      <Icon name={icon} size={20} />
    </div>
    {badgeText && <span class="bento-badge">{badgeText}</span>}
  </div>

  <div class="bento-text-group">
    <h3 class="bento-title">{title}</h3>
    <p class="bento-description">{description}</p>
  </div>

  <div class="bento-visual-slot">
    <slot />
  </div>
</div>

<style>
  .bento-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(20px, 3.5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .bento-card:hover {
    border-color: var(--color-border-highlight);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(6, 9, 14, 0.6);
  }

  /* Specular top glow line */
  .bento-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(107, 249, 156, 0.4), transparent);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  /* Tablet grid column spans (768px - 1023px) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .col-span-4,
    .col-span-6 {
      grid-column: span 6;
    }

    .col-span-8,
    .col-span-12 {
      grid-column: span 12;
    }
  }

  /* Desktop grid column spans (1024px+) */
  @media (min-width: 1024px) {
    .col-span-4 {
      grid-column: span 4;
    }

    .col-span-6 {
      grid-column: span 6;
    }

    .col-span-8 {
      grid-column: span 8;
    }

    .col-span-12 {
      grid-column: span 12;
    }
  }

  .bento-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bento-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-subtle);
    color: var(--color-primary);
    border: 1px solid rgba(107, 249, 156, 0.2);
  }

  .bento-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-secondary);
    background-color: var(--color-secondary-subtle);
    border: 1px solid rgba(3, 169, 163, 0.3);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .bento-text-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .bento-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .bento-description {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .bento-visual-slot {
    margin-top: auto;
    width: 100%;
  }
</style>
