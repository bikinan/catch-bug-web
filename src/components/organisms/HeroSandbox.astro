  }

  .detail-code-box {
    background-color: var(--color-surface-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    overflow-x: auto;
    max-height: 100px;
    overflow-y: auto;
    word-break: break-all;
    white-space: pre-wrap;
  }

  .params-code {
    display: block;
    line-height: 1.45;
  }

  .param-key {
    color: var(--color-status-warning);
    font-weight: 600;
  }

  .param-val {
    color: var(--color-text-primary);
  }

  .syntax-masked {
    color: var(--color-primary);
    font-weight: 700;
    background-color: var(--color-primary-subtle);
    padding: 1px 4px;
    border-radius: var(--radius-sm);
  }

  /* 5. Bottom Panel Footer */
  .panel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background-color: var(--color-surface-raised);
    border-top: 1px solid var(--color-border-subtle);
  }

  .footer-integrations {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .btn-integration {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-integration:hover {
    background-color: var(--color-surface-card-hover);
    border-color: var(--color-border-highlight-teal);
  }

  .int-icon {
    font-size: 0.75rem;
  }

  .int-badge {
    background-color: var(--color-status-warning-subtle);
    border: 1px solid var(--color-status-warning);
    color: var(--color-status-warning);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    line-height: 1;
  }

  .btn-export-md {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-export-md:hover {
    background-color: var(--color-surface-card-hover);
    border-color: var(--color-secondary);
    color: var(--color-primary);
  }

  .export-icon {
    font-size: 0.75rem;
  }

  /* ---------------------------------------------------- */
  /* AUTHENTIC MINIMIZED FLOATING PILL DOCK (Image 2)     */
  /* ---------------------------------------------------- */
  .minimized-dock {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 6px 6px 14px;
    background-color: rgba(10, 14, 22, 0.96);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(6, 9, 14, 0.85);
    user-select: none;
    z-index: 30;
    transition: all var(--transition-base);
  }

  .minimized-dock:hover {
    border-color: var(--color-border-highlight-teal);
    transform: translateY(-2px);
    box-shadow:
      0 12px 35px rgba(6, 9, 14, 0.95),
      0 0 12px rgba(107, 249, 156, 0.2);
  }

  .dock-logo {
    display: block;
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .dock-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .dock-badge-solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background-color: var(--color-status-error);
    color: var(--color-text-primary);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 0 8px var(--color-status-error-subtle);
  }

  /* Toast Notification */
  .sandbox-toast {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-primary);
    box-shadow:
      0 8px 24px rgba(6, 9, 14, 0.8),
      0 0 16px var(--color-primary-glow);
    padding: 8px 16px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
    z-index: 50;
    pointer-events: none;
    animation: toast-in 200ms ease-out;
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 10px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .toast-check {
    font-weight: 700;
  }

  .hidden {
    display: none !important;
  }

  /* Mobile and Small Screen Adaptation */
  @media (max-width: 480px) {
    .sandbox-canvas {
      min-height: 480px;
      padding: 8px;
    }

    .catchbug-panel {
      max-width: 100%;
    }

    .panel-top-bar {
      padding: 8px 10px;
    }

    .top-actions {
      gap: 4px;
    }

    .btn-top {
      padding: 4px 6px;
      font-size: 0.6875rem;
    }

    .minimized-dock {
      bottom: 16px;
      right: 16px;
      padding: 5px 5px 5px 12px;
    }
  }
</style>

<script>
  function initInteractiveCatchBug() {
    const btnTrigger = document.getElementById("btn-trigger-crash");
    const cardCrash = document.getElementById("card-crash");
    const eventCountBadge = document.getElementById("event-count-badge");
    const tabCountAll = document.getElementById("tab-count-all");
    const tabCountNet = document.getElementById("tab-count-net");
    const btnCopyTop = document.getElementById("btn-copy-top");
    const copyBtnLabel = document.getElementById("copy-btn-label");
    const btnExportMd = document.getElementById("btn-export-md");
    const btnSnap = document.getElementById("btn-snap");
    const cameraFlash = document.getElementById("camera-flash");
    const btnClear = document.getElementById("btn-clear");
    const btnCollapse = document.getElementById("btn-collapse");
    const catchbugPanel = document.getElementById("catchbug-panel");
    const minimizedDock = document.getElementById("minimized-dock");
    const minDockCount = document.getElementById("min-dock-count");
    const toast = document.getElementById("sandbox-toast");
    const toastMessage = document.getElementById("toast-message");
    const filterTabs = document.querySelectorAll(".filter-tabs .tab-btn");

    let toastTimer: any = null;

    function showToast(msg: string) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = msg;
      toast.classList.remove("hidden");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add("hidden");
      }, 2500);
    }

    const sampleMarkdownReport = `### 🐛 [CatchBug] HTTP 500 on POST /api/v1/checkout/charge
**Status**: 500 Internal Server Error (142ms)
**URL**: https://staging.app/checkout
**Timestamp**: 9:24:02 AM

#### 🔒 Sanitized Request Headers
\`\`\`http
Authorization: Bearer ******************** [MASKED]
Content-Type: application/json
\`\`\`

#### 📦 Payload
\`\`\`json
{
  "plan": "enterprise",
  "amount": 4900,
  "status": "failed",
  "error": "PaymentGatewayTimeout"
}
\`\`\`

#### 🐾 Action Breadcrumbs
1. \`9:23:11 AM\` POST analytics.google.com/g/collect (HTTP 0)
2. \`9:23:15 AM\` POST analytics.google.com/g/collect (HTTP 0)
3. \`9:24:02 AM\` Clicked button#btn-trigger-crash -> 500 Server Error
`;

    // 1. Accordion Expand/Collapse on each Event Card
    const allCards = document.querySelectorAll(".event-card");
    allCards.forEach((card) => {
      const header = card.querySelector(".card-header");
      const details = card.querySelector(".card-details");
      const expandIcon = card.querySelector(".card-expand-icon");

      if (header && details) {
        header.addEventListener("click", (e) => {
          // Prevent click on copy button from collapsing
          if ((e.target as HTMLElement).closest(".btn-copy-card")) return;

          const isExpanded = !details.classList.contains("hidden");
          if (isExpanded) {
            details.classList.add("hidden");
            if (expandIcon) expandIcon.textContent = "⌄";
            header.setAttribute("aria-expanded", "false");
          } else {
            details.classList.remove("hidden");
            if (expandIcon) expandIcon.textContent = "⌃";
            header.setAttribute("aria-expanded", "true");
          }
        });
      }

      const copyCardBtn = card.querySelector(".btn-copy-card");
      if (copyCardBtn) {
        copyCardBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          try {
            await navigator.clipboard.writeText(sampleMarkdownReport);
            showToast("📋 Event telemetry copied to clipboard!");
          } catch {
            showToast("📋 Copied!");
          }
        });
      }
    });

    // 2. Trigger Crash
    if (btnTrigger) {
      btnTrigger.addEventListener("click", () => {
        if (catchbugPanel && catchbugPanel.classList.contains("hidden")) {
          catchbugPanel.classList.remove("hidden");
          minimizedDock?.classList.add("hidden");
        }

        if (cardCrash) {
          cardCrash.classList.remove("hidden");
          const crashTime = document.getElementById("crash-time");
          if (crashTime) {
            const now = new Date();
            crashTime.textContent = now.toLocaleTimeString();
          }
        }

        if (eventCountBadge) {
          eventCountBadge.textContent = "5/10";
          eventCountBadge.classList.add("pulse-alert");
          setTimeout(
            () => eventCountBadge.classList.remove("pulse-alert"),
            1200,
          );
        }
        if (minDockCount) minDockCount.textContent = "5";
        if (tabCountAll) tabCountAll.textContent = "5";
        if (tabCountNet) tabCountNet.textContent = "5";

        showToast("💥 500 API crash intercepted & masked by CatchBug!");
      });
    }

    // 3. Snap feature (Camera Flash)
    if (btnSnap && cameraFlash) {
      btnSnap.addEventListener("click", () => {
        cameraFlash.classList.add("flash-active");
        setTimeout(() => {
          cameraFlash.classList.remove("flash-active");
          showToast("📸 In-viewport visual snapshot captured!");
        }, 120);
      });
    }

    // 4. Copy Markdown Report
    async function copyReport() {
      try {
        await navigator.clipboard.writeText(sampleMarkdownReport);
        if (copyBtnLabel) copyBtnLabel.textContent = "Copied!";
        showToast("📋 Markdown report copied to clipboard!");
        setTimeout(() => {
          if (copyBtnLabel) copyBtnLabel.textContent = "Copy";
        }, 2000);
      } catch {
        showToast("📋 Report copied!");
      }
    }

    if (btnCopyTop) btnCopyTop.addEventListener("click", copyReport);
    if (btnExportMd) btnExportMd.addEventListener("click", copyReport);

    // 5. Clear events
    if (btnClear) {
      btnClear.addEventListener("click", () => {
        if (cardCrash) cardCrash.classList.add("hidden");
        if (eventCountBadge) eventCountBadge.textContent = "0/10";
        if (minDockCount) minDockCount.textContent = "0";
        if (tabCountAll) tabCountAll.textContent = "0";
        if (tabCountNet) tabCountNet.textContent = "0";
        showToast("Cleared captured telemetry");
      });
    }

    // 6. Minimize & Expand (Pill Dock - Image 2)
    if (btnCollapse && catchbugPanel && minimizedDock) {
      btnCollapse.addEventListener("click", () => {
        catchbugPanel.classList.add("hidden");
        minimizedDock.classList.remove("hidden");
        showToast("Dock minimized (Click pill to reopen)");
      });
    }

    if (minimizedDock && catchbugPanel) {
      minimizedDock.addEventListener("click", () => {
        minimizedDock.classList.add("hidden");
        catchbugPanel.classList.remove("hidden");
      });
    }

    // 7. Tabs Filter
    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        filterTabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        const tabName = tab.getAttribute("data-tab");
        showToast(`Filtered view: ${tabName?.toUpperCase()}`);
      });
    });
  }

  initInteractiveCatchBug();
  document.addEventListener("astro:page-load", initInteractiveCatchBug);
</script>
