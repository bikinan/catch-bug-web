  /* Injected Crash Card Styling */
  .event-crash {
    border-color: var(--color-status-error);
    background-color: rgba(244, 63, 94, 0.1);
  }

  /* Expanded Card Details (Matching Reference Image 1) */
  .card-details {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .status-info-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .status-info-label {
    color: var(--color-text-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .status-info-text {
    color: var(--color-text-primary);
  }

  .status-info-text.text-err {
    color: var(--color-status-error);
    font-weight: 600;
  }

  .detail-block {
