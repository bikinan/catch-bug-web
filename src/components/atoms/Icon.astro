    | "chrome"
    | "github"
    | "terminal"
    | "shield"
    | "check"
    | "copy"
    | "sparkles"
    | "zap"
    | "arrow-right"
    | "arrow-left"
    | "external-link"
    | "alert-triangle"
    | "refresh"
    | "layers"
    | "lock"
    | "footprints"
    | "send"
    | "brain"
    | "activity"
    | "clock"
    | "x"
    | "x-circle"
    | "file-text"
    | "download"
    | "menu";
