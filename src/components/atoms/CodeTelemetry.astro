---
interface Props {
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'LOG' | 'ERROR';
  url?: string;
  status?: number | string;
  duration?: string;
  class?: string;
}

const {
  method = 'POST',
  url = '/api/v1/checkout',
  status = '500',
  duration = '142ms',
  class: className = ''
} = Astro.props;
---

<div class={`telemetry-pill ${className}`}>
  <span class={`method method-${method.toLowerCase()}`}>{method}</span>
  <span class="url">{url}</span>
  <span class="status status-err">{status}</span>
  <span class="duration">{duration}</span>
</div>

<style>
  .telemetry-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background-color: rgba(6, 9, 14, 0.85);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .method {
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.6875rem;
  }

  .method-post {
    background-color: rgba(245, 158, 11, 0.15);
    color: var(--color-status-warning);
  }

  .method-error {
    background-color: rgba(244, 63, 94, 0.15);
    color: var(--color-status-error);
  }

  .url {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .status {
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .status-err {
    background-color: var(--color-status-error-subtle);
    color: var(--color-status-error);
    border: 1px solid rgba(244, 63, 94, 0.3);
  }

  .duration {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }
</style>
