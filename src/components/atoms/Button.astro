---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  id,
  class: className = ''
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={target === '_blank' && !rel ? 'noopener noreferrer' : rel}
  type={!href ? type : undefined}
  id={id}
  class={`btn btn-${variant} btn-${size} ${className}`}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
    white-space: nowrap;
    user-select: none;
    border: 1px solid transparent;
  }

  /* Sizes */
  .btn-sm {
    padding: 8px 16px;
    font-size: 0.8125rem;
  }

  .btn-md {
    padding: 12px 24px;
    font-size: 0.9375rem;
  }

  .btn-lg {
    padding: 14px 30px;
    font-size: 1rem;
    font-weight: 700;
  }

  /* Primary Variant: Cyber Mint */
  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    border-color: var(--color-primary);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--color-primary-glow);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  /* Secondary Variant: Deep Glass & Teal Border */
  .btn-secondary {
    background-color: var(--color-surface-card);
    color: var(--color-text-primary);
    border-color: var(--color-border-highlight-teal);
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-card-hover);
    border-color: var(--color-secondary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  /* Ghost Variant */
  .btn-ghost {
    background-color: transparent;
    color: var(--color-text-secondary);
    border-color: transparent;
  }

  .btn-ghost:hover {
    color: var(--color-text-primary);
    background-color: rgba(255, 255, 255, 0.04);
  }

  /* Danger / Trigger Variant */
  .btn-danger {
    background-color: var(--color-status-error-subtle);
    color: var(--color-status-error);
    border-color: rgba(244, 63, 94, 0.4);
    font-family: var(--font-mono);
  }

  .btn-danger:hover {
    background-color: rgba(244, 63, 94, 0.25);
    border-color: var(--color-status-error);
    box-shadow: 0 4px 20px rgba(244, 63, 94, 0.3);
    transform: translateY(-1px);
  }

  .btn-danger:active {
    transform: translateY(0);
  }
</style>
