---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderNav from "../components/organisms/HeaderNav.astro";
import HeroSection from "../components/organisms/HeroSection.astro";
import BentoGrid from "../components/organisms/BentoGrid.astro";
import ContrastMatrix from "../components/organisms/ContrastMatrix.astro";
import SiteFooter from "../components/organisms/SiteFooter.astro";
---

<BaseLayout
  title="CatchBug - Zero-Friction Bug Reporting Chrome Extension"
  description="Turn 5 minutes of tedious bug reporting into a 3-second, one-click diagnostic dispatch. Auto-captures failing endpoints, console errors, and click breadcrumbs with zero credential leaks."
>
  <HeaderNav />
  <main id="main-content">
    <HeroSection />
    <BentoGrid />
    <ContrastMatrix />
  </main>
  <SiteFooter />
</BaseLayout>
